# Maintainer: MW0MWZ <andy@mw0mwz.co.uk>
#
# A local package: its source is this directory. Shell scripts, but built
# per arch: apk fetches a noarch package from a noarch/ directory, which
# this repository does not have. The build gives each
# build of a version the next -rN; change pkgver for a new version.
pkgname=raspine-watchdog
pkgver=1.0.0
pkgrel=0
pkgdesc="Raspberry Pi hardware watchdog, hung-shutdown resets, service checks with a reboot-loop guard"
url="https://raspine.pistar.uk"
arch="armhf aarch64"
license="GPL-2.0-only"
depends="busybox openrc"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
options="!check"
source="
	raspine-watchdog.initd
	raspine-watchdog-health.initd
	raspine-watchdog.confd
	raspine-watchdog-health
	raspine-watchdog-mark
	raspine-watchdog-fresh
	README.checks
	"

package() {
	install -Dm755 "$srcdir"/raspine-watchdog.initd "$pkgdir"/etc/init.d/raspine-watchdog
	install -Dm755 "$srcdir"/raspine-watchdog-health.initd "$pkgdir"/etc/init.d/raspine-watchdog-health
	install -Dm644 "$srcdir"/raspine-watchdog.confd "$pkgdir"/etc/conf.d/raspine-watchdog
	for f in raspine-watchdog-health raspine-watchdog-mark raspine-watchdog-fresh; do
		install -Dm755 "$srcdir"/$f "$pkgdir"/usr/sbin/$f
	done
	install -Dm644 "$srcdir"/README.checks "$pkgdir"/etc/raspine-watchdog.d/README
	install -dm755 "$pkgdir"/var/lib/raspine-watchdog
}
